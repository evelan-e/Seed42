# Copy to .env and fill in. Everything has a working default except the Groq key.

# Groq key for the LLM step. Without it every window uses the fallback prompt.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
MAX_PROMPT_WORDS=40

# full = Librosa + Madmom + Essentia + Whisper
# lite = Librosa only (for working on the page or the Control API path)
PIPELINE_MODE=full
WHISPER_SIZE=tiny
N_THEMES=4

# Control API. Docker Compose overrides the URL to point at the mock container.
CONTROL_API_URL=http://127.0.0.1:8787
CONTROL_API_EMAIL=test@example.com
CONTROL_API_PASSWORD=anything

# Scenes. Each window gets a change score from 0 (same music) to 1.
# Under EVOLVE_AT the prompt is re-sent unchanged; from EVOLVE_AT it's adjusted;
# from CHANGE_AT it blends, then is replaced if the next window confirms it.
SCENE_EVOLVE_AT=0.25
SCENE_CHANGE_AT=0.5
# Near silence this long inside a window suggests a track change
SCENE_GAP_SEC=1.5

# What the page's window and step boxes start at, in seconds
DEFAULT_WINDOW_SEC=20
DEFAULT_STEP_SEC=10
